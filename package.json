{
  "name": "crawlbrulee",
  "version": "3.2.0",
  "description": "Official CLI for the crawlbrulee API — scrape, map, and inspect usage from your terminal.",
  "keywords": [
    "crawlbrulee",
    "cli",
    "scrape",
    "scraping",
    "crawler",
    "web-scraping",
    "screenshot",
    "sitemap"
  ],
  "license": "AGPL-3.0-only",
  "homepage": "https://crawlbrulee.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crawlbrulee/crawlbrulee-cli.git"
  },
  "bugs": {
    "url": "https://github.com/crawlbrulee/crawlbrulee-cli/issues"
  },
  "type": "module",
  "packageManager": "pnpm@10.10.0",
  "bin": {
    "crawlbrulee": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "rm -rf dist coverage node_modules",
    "verify": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build",
    "prepublishOnly": "pnpm verify"
  },
  "dependencies": {
    "@crawlbrulee/sdk": "^0.9.0",
    "@inquirer/prompts": "^7.0.0",
    "commander": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.18.0",
    "prettier": "^3.4.0",
    "tsdown": "^0.22.11",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^3.2.6"
  }
}
